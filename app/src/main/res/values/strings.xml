    <string name="image_sketch_radius_label">模糊半径</string>
    <string name="image_sketch_radius_value">%1$d px</string>
    <string name="image_sketch_radius_hint">半径越大线条越凝练；偶数半径会自动取相邻奇数</string>
    <string name="image_sketch_step_grayscale">灰度化</string>
    <string name="image_sketch_step_invert">反相</string>
    <string name="image_sketch_step_blur">高斯模糊</string>
    <string name="image_sketch_step_dodge">颜色减淡</string>
    <string name="image_sketch_zoom_hint">点击放大</string>
    <string name="image_sketch_save">保存素描</string>
    <string name="image_sketch_need_image">请先选取一张图片</string>
    <string name="image_sketch_load_failed">图片加载失败</string>
    <string name="image_sketch_process_failed">素描生成失败，请重试</string>
    <string name="image_sketch_saved_success">已保存素描图至相册 (Pictures/Koishi/ImageSketch)</string>
    <string name="image_sketch_save_failed">保存图片至相册失败</string>
    <string name="image_sketch_help_title">图片素描原理解析</string>
    <string name="image_sketch_help_p1">【处理流程】先把图片转为灰度图，再对灰度图取反相（255 减灰度值），随后对反相图做高斯模糊，得到的模糊反相图与原灰度图一起送入颜色减淡公式混合，最终输出铅笔素描效果。</string>
    <string name="image_sketch_help_p2">【核心公式】结果 = min(255, 灰度 × 255 ÷ (255 − 模糊值 + 1e-5))。平坦区域中模糊值约等于自身反相值，相除后趋近于 255（纯白）；而边缘处两者差异明显，除法结果骤降，于是勾勒出深色线条。</string>
    <string name="image_sketch_help_p3">【参数建议】模糊半径决定线条的粗细与保留的细节量，取值范围 1 ~ 100，默认 15。半径越小越接近原图细节，半径越大画面越干净凝练。为便于对称取样，偶数半径会被自动调整为相邻奇数。</string>

