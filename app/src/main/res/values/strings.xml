    <string name="tool_image_sketch_name">图片素描</string>
    <string name="tool_image_sketch_desc">高斯模糊结合颜色减淡，一键把照片变成铅笔素描线稿</string>
    <string name="image_sketch_title">图片素描</string>
    <string name="image_sketch_empty_prompt">点击下方按钮选取图片，生成素描线稿</string>
    <string name="image_sketch_pick_image">选择图片</string>
    <string name="image_sketch_param_title">算法参数</string>
    <string name="image_sketch_source_resolution">源图 %1$d × %2$d px</string>
